diff --git a/PyTorchSimFrontend/interface_manifest.py b/PyTorchSimFrontend/interface_manifest.py
new file mode 100644
index 0000000..387d6b2
--- /dev/null
+++ b/PyTorchSimFrontend/interface_manifest.py
@@ -0,0 +1,28 @@
+"""Optional allocation receipt for the pinned plain-GEMM interface contract."""
+import hashlib,json,re,subprocess
+from pathlib import Path
+
+
+def emit_allocation_manifest(binary,assembly,stack_bytes,static_bytes,capacity,lanes):
+    binary=Path(binary);assembly=Path(assembly)
+    symbols=subprocess.check_output(['riscv64-unknown-elf-readelf','-sW',str(binary)],text=True)
+    (binary.parent/'allocation_symbols.txt').write_text(symbols)
+    entries=[]
+    for line in symbols.splitlines():
+        fields=line.split()
+        if len(fields)==8 and fields[0].endswith(':') and fields[0][:-1].isdigit():
+            entries.append(dict(address=int(fields[1],16),size=int(fields[2],0),type=fields[3],section=fields[6],name=fields[7]))
+    start=next(e for e in entries if e['type']=='SECTION' and e['name']=='.spad')
+    end=next(e for e in entries if e['name']=='spad_end')
+    objects=sorted((e for e in entries if e['type']=='OBJECT' and e['section']==start['section'] and e['size']),key=lambda e:e['address'])
+    if end['address']-start['address']!=static_bytes:raise RuntimeError('ELF scratchpad extent mismatch')
+    if any(e['address']<start['address'] or e['address']+e['size']>end['address'] for e in objects):raise RuntimeError('Scratchpad object exceeds allocation extent')
+    for left,right in zip(objects,objects[1:]):
+        if left['address']+left['size']>right['address']:raise RuntimeError('Overlapping scratchpad objects')
+    if type(stack_bytes) is not int or stack_bytes<0:raise RuntimeError('Unknown kernel stack requirement')
+    kernel_body=assembly.read_text().split('.cfi_startproc',1)[1].split('.cfi_endproc',1)[0]
+    calls=bool(re.search(r'^\s*(call|jal|jalr)\s',kernel_body,re.MULTILINE))
+    buffers=[dict(name=e['name'],offset_bytes=e['address']-start['address'],bytes_per_lane=e['size'],region='lane_scratchpad',lifetime='entire_kernel',copies=1) for e in objects]
+    supported=set(e['name'] for e in objects)=={'X_spad','W_spad','Y_spad'} and not calls
+    result=dict(schema='pytorchsim-allocation.v1',basis='ELF static extent plus pinned compiler kernel stack',region='lane_scratchpad',lanes=lanes,capacity_bytes_per_lane=capacity,static_extent_bytes_per_lane=static_bytes,static_object_bytes_per_lane=sum(e['size'] for e in objects),alignment_padding_bytes_per_lane=static_bytes-sum(e['size'] for e in objects),kernel_stack_bytes_per_lane=stack_bytes,required_bytes_per_lane=static_bytes+stack_bytes,buffers=buffers,compiler_capacity_pass=static_bytes+stack_bytes<=capacity,plain_gemm_scope=supported,kernel_has_calls=calls,binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),assembly_sha256=hashlib.sha256(assembly.read_bytes()).hexdigest(),scope_note='Capacity certificate requires serialized timing tiles. Wrapper host stack, DMA tags and queues belong to separate backend resources; no full-chip area or energy claim.')
+    (binary.parent/'allocation_manifest.json').write_text(json.dumps(result,indent=2)+'\n')
