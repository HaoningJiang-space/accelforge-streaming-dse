+
+void Simulator::write_final_json(const std::string& path, uint64_t launches) {
+  if (running() || launches == 0) throw std::runtime_error("Cannot certify incomplete or empty execution");
+  const auto counts = _dram->total_transactions();
+  uint64_t loads=0, stores=0;
+  for (const auto& core : _cores) { loads += core->instruction_count(Opcode::MOVIN); stores += core->instruction_count(Opcode::MOVOUT); }
+  const auto tmp = path + ".tmp";
+  std::ofstream out(tmp); out.exceptions(std::ios::badbit | std::ios::failbit);
+  out << "{\"schema\":\"togsim-final.v1\",\"completed\":true,\"scope\":\"cumulative\","
+      << "\"launched_kernels\":" << launches << ",\"total_cycles\":" << _core_cycles
+      << ",\"dram_channels\":" << _config.dram_channels << ",\"request_bytes\":" << _memory_req_size
+      << ",\"read_transactions\":" << counts.first << ",\"write_transactions\":" << counts.second
+      << ",\"dma_load_instructions\":" << loads << ",\"dma_store_instructions\":" << stores
+      << ",\"serial_tiles\":" << (_max_slot==1 ? "true" : "false") << "}\n";
+  out.close(); fs::rename(tmp,path);
+}
